# Port the API (and the built client) is served on
PORT=4000

# Signing secret for JSON Web Tokens. Required: the server refuses to start in
# production without it. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: path to the SQLite file (defaults to server/genomika.db)
# DB_PATH=./genomika.db

# Where uploaded CVs are written. In Docker this points at the named volume.
UPLOAD_DIR=./uploads

# Set to "false" to start with an empty database instead of demo content.
AUTO_SEED=true

# Passwords for the seeded accounts, per role. Outside production both default
# to "genomika2026"; in production an unset one is generated on first seed and
# printed once to the log.
# ADMIN_PASSWORD=
# DEMO_PASSWORD=

# Which demo accounts the login page lists: none, researcher or all.
# Defaults to "all" outside production and "none" in production.
# DEMO_LOGINS=none
